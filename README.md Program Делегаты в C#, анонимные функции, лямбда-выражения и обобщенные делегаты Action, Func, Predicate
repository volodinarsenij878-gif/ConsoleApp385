    public delegate decimal CurrencyTransformer(decimal amount, double factor);

    public static class FinancialOperations
    {
        // Сумма с учетом налога
        public static decimal ApplyTax(decimal amount, double taxRate)
        {
            return amount * (decimal)(1.0 + taxRate);
        }

        // Снижение суммы на скидку
        public static decimal ApplyDiscount(decimal amount, double discountPercent)
        {
            return amount - (amount * (decimal)discountPercent);
        }

        // Умножение на коэффициент инфляции
        public static decimal ApplyInflationIndex(decimal amount, double rate)
        {
            return amount * (decimal)rate;
        }
    }

