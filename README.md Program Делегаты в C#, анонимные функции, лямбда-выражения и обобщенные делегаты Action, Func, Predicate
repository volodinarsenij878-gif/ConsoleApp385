    public delegate void AuditLogger(string transactionInfo);

    public static class AuditDispatch
    {
        // Обычный вывод в консоль
        public static void LogToConsole(string info)
        {
            Console.WriteLine($"[ЛОГ]: {info}");
        }

        // Желтым цветом — модуль финансового мониторинга
        public static void LogToSecurityMonitor(string info)
        {
            Console.ForegroundColor = ConsoleColor.Yellow;
            Console.WriteLine($"[FIN-MONITORING]: {info}");
            Console.ResetColor();
        }

        // Синим цветом — имитация записи в файл
        public static void LogToFileSimulation(string info)
        {
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine($"[STORAGE-WRITE]: {info}");
            Console.ResetColor();
        }
    }

